{
  "name": "acceptance-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "npm run postinstall:chrome && npm run postinstall:chromedriver",
    "postinstall:chrome": "npx @puppeteer/browsers install chrome@129",
    "postinstall:chromedriver": "npx @puppeteer/browsers install chromedriver@129",
    "test": "protractor ./protractor.conf.js",
    "test:report": "npx @serenity-js/html-reporter serve --dir ./reports/serenity-js --open",
    "lint": "eslint --ext ts --config .eslintrc.js .",
    "lint:fix": "npm run lint -- --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serenity-js/serenity-js-jasmine-protractor-template.git"
  },
  "keywords": [
    "serenity-js",
    "bdd",
    "jasmine",
    "protractor",
    "testing"
  ],
  "author": "Jan Molak <jan.molak@smartcodeltd.co.uk>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/serenity-js/serenity-js-jasmine-protractor-template/issues"
  },
  "homepage": "https://serenity-js.org",
  "engines": {
    "node": "^20 || ^22 || ^24"
  },
  "dependencies": {
    "@serenity-js/assertions": "^3.46.0",
    "@serenity-js/console-reporter": "^3.46.0",
    "@serenity-js/core": "^3.46.0",
    "@serenity-js/html-reporter": "^3.46.0",
    "@serenity-js/jasmine": "^3.46.0",
    "@serenity-js/protractor": "^3.46.0",
    "@serenity-js/web": "^3.46.0",
    "jasmine": "^6.3.0",
    "protractor": "^7.0.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^2.13.2",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^52.0.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
